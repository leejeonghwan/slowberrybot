[Unit]
Description=Daum Trends Web App
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/assembly-signal
Environment=DAUM_TRENDS_CACHE_TTL=60
Environment=DAUM_TRENDS_STALE_IF_ERROR_SECONDS=21600
Environment=DAUM_TRENDS_TIMEOUT_SECONDS=10
Environment=DAUM_TRENDS_STATE_PATH=/opt/assembly-signal/runtime/daum_trends_snapshot.json
ExecStart=/opt/assembly-signal/.venv-web/bin/gunicorn --bind 127.0.0.1:8787 --workers 2 --threads 4 --worker-class gthread --timeout 30 daum_trends_web.wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

